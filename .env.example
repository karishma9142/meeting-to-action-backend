PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/meeting2action

# LLM (OpenAI-compatible). Groq free tier:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key
LLM_MODEL=llama-3.3-70b-versatile
# Local alternative (Ollama): http://localhost:11434/v1 , key=ollama , model=llama3.1:8b

# Whisper (Groq free tier, 25MB file limit)
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_API_KEY=gsk_your_key
WHISPER_MODEL=whisper-large-v3

# Video support + large files need ffmpeg installed on the machine running the server
# (Windows: winget install ffmpeg | Mac: brew install ffmpeg | Ubuntu: sudo apt install ffmpeg)

# Task backend: github | trello | none
TASK_BACKEND=none
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Name used to sign reminder emails
SENDER_NAME=Your Name

# Login security (generate with: openssl rand -hex 32)
JWT_SECRET=change-me

# Emails. MAIL_MODE=test sends to a free fake inbox and shows a preview link (no real emails).
MAIL_MODE=test
# For REAL emails (e.g. Gmail with an App Password), fill these in; they override MAIL_MODE:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=you@gmail.com

# Daily 9am emails for overdue/slipping tasks (off by default)
DAILY_REMINDERS=false
